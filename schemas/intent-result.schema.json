{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edaguard.dev/schemas/intent-result.schema.json",
  "title": "EDA-Guard Intent Verification Result",
  "description": "Auditable result of evaluating a compiled intent against one Semantic Diff.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "intent_id", "passed", "summary", "violations", "decisions"],
  "properties": {
    "schema": { "const": "edaguard.intent-result.v1" },
    "schema_version": { "type": "string" },
    "intent_id": { "type": ["string", "null"] },
    "description": { "type": "string" },
    "status": { "enum": ["PASS", "FAIL", "INVALID_POLICY", "BASELINE_MISMATCH", "INVALID_DIFF"] },
    "valid": { "type": "boolean" },
    "passed": { "type": "boolean" },
    "baseline_match": { "type": "boolean" },
    "baseline": { "type": ["object", "null"] },
    "diff": { "type": ["object", "null"] },
    "summary": {
      "type": "object",
      "required": ["allowed", "denied", "unexpected", "missing_required"],
      "properties": {
        "allowed": { "type": "integer", "minimum": 0 },
        "denied": { "type": "integer", "minimum": 0 },
        "unexpected": { "type": "integer", "minimum": 0 },
        "missing_required": { "type": "integer", "minimum": 0 },
        "total_events": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "required_results": { "type": "array" },
    "decisions": { "type": "array" },
    "violations": { "type": "array" },
    "missing_required": { "type": "array" },
    "errors": { "type": "array" },
    "warnings": { "type": "array" }
  }
}
